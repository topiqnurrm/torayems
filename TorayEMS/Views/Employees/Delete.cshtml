@model Employee
@{
    ViewData["Title"] = "Hapus Karyawan";
}

<h1 class="mb-4 text-danger">Hapus Karyawan</h1>

<p>Apakah Anda yakin ingin menghapus data karyawan berikut?</p>

<div class="card shadow-sm border-0 border-start border-danger border-4" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nama Lengkap</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Jabatan</dt>
            <dd class="col-sm-8">@Model.Position</dd>

            <dt class="col-sm-4">Departemen</dt>
            <dd class="col-sm-8">@Model.DepartmentName</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="EmployeeId" />
    <button type="submit" class="btn btn-danger">Ya, Hapus</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Batal</a>
</form>
