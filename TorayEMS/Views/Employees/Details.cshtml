@model Employee
@{
    ViewData["Title"] = "Detail Karyawan";
}

<h1 class="mb-4">Detail Karyawan</h1>

<div class="card shadow-sm border-0" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nama Lengkap</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Jabatan</dt>
            <dd class="col-sm-8">@Model.Position</dd>

            <dt class="col-sm-4">Departemen</dt>
            <dd class="col-sm-8">@Model.DepartmentName</dd>

            <dt class="col-sm-4">Tanggal Masuk</dt>
            <dd class="col-sm-8">@Model.HireDate.ToString("dd MMMM yyyy")</dd>

            <dt class="col-sm-4">Gaji</dt>
            <dd class="col-sm-8">@Model.Salary.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</dd>

            <dt class="col-sm-4">No. Telepon</dt>
            <dd class="col-sm-8">@Model.PhoneNumber</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Aktif</span>
                }
                else
                {
                    <span class="badge bg-secondary">Non-aktif</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn toray-btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Kembali</a>
</div>
