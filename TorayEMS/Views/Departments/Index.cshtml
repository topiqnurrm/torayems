@model List<Department>
@{
    ViewData["Title"] = "Data Departemen";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Data Departemen</h1>
    <a asp-action="Create" class="btn toray-btn-primary">+ Tambah Departemen</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle bg-white shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Nama Departemen</th>
                <th>Deskripsi</th>
                <th class="text-end">Aksi</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">Belum ada data departemen.</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.DepartmentName</td>
                    <td>@item.Description</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.DepartmentId" class="btn btn-sm btn-outline-danger">Hapus</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
